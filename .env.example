# ===== Web (apps/web) — copia este archivo como .env.local y completa =====
# Sin VITE_SUPABASE_* la app funciona en modo local (datos solo en este navegador, con datos de ejemplo).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Planner (Microsoft Graph, solo lectura): se llenan al registrar la aplicación en Entra ID (ver README).
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=
# API Node opcional (avisos a Teams confirmados + envío programado). Ej: http://localhost:8787
VITE_API_URL=
# Ruta donde se publica el sitio. GitHub Pages: /nombre-del-repo/
VITE_BASE=/

# ===== API (apps/api) — variables de entorno del servidor, NUNCA en el navegador =====
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGIN=http://localhost:5173
PORT=8787
AVISOS_TZ=America/Santiago
AVISOS_SCHEDULER=0
